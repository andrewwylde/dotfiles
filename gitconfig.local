[mergetool "opendiff"]
  path = /usr/bin/opendiff
[merge]
  tool = opendiff
[difftool "opendiff"]
  path = /usr/bin/opendiff
[diff]
  tool = opendiff
[difftool]
  prompt = false
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[user]
