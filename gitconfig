[init]
  defaultBranch = main
  templatedir = ~/.git_template
[push]
  default = current
[color]
  ui = auto
[core]
  excludesfile = ~/.gitignore
  autocrlf = input
  editor = /usr/bin/vim
[commit]
  template = ~/.gitmessage
  gpgSign = true
[fetch]
  prune = true
[rebase]
  autosquash = true
[pull]
  rebase = true
[include]
  path = ~/.gitconfig.local
[diff]
  colorMoved = zebra
[alias]
  lg = log --graph --all --decorate --oneline
  st = status
  co = checkout
  clean-safe = clean -dfx -e .env*
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
