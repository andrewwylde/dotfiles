#!/usr/bin/env bash
# Legacy entrypoint — prefer agent-sync; fall back to symlink installer during migration.
set -euo pipefail

DOTFILES="${DOTFILES_DIR:-${HOME}/dotfiles}"
if [[ ! -d "${DOTFILES}" && -d "${HOME}/dotfiles-local" ]]; then
  DOTFILES="${HOME}/dotfiles-local"
fi

run_agent_sync() {
  local bin=""
  if [[ -x "${HOME}/.local/bin/agent-sync" ]]; then
    bin="${HOME}/.local/bin/agent-sync"
  elif [[ -x "${DOTFILES}/bin/agent-sync" && -f "${DOTFILES}/bin/agent-sync" ]]; then
    # Prefer real binary or wrapper that can resolve a build.
    if head -1 "${DOTFILES}/bin/agent-sync" | grep -q '^#!'; then
      bin="${DOTFILES}/bin/agent-sync"
    elif [[ -x "${DOTFILES}/agent-sync/target/release/agent-sync" ]]; then
      bin="${DOTFILES}/agent-sync/target/release/agent-sync"
    fi
  elif [[ -x "${DOTFILES}/agent-sync/target/release/agent-sync" ]]; then
    bin="${DOTFILES}/agent-sync/target/release/agent-sync"
  fi
  [[ -n "${bin}" ]] || return 127

  case "${1:-}" in
    --verify)
      DOTFILES_DIR="${DOTFILES}" "${bin}" verify
      ;;
    --dry-run)
      DOTFILES_DIR="${DOTFILES}" "${bin}" sync --dry-run
      ;;
    "" )
      DOTFILES_DIR="${DOTFILES}" "${bin}" sync
      ;;
    *)
      DOTFILES_DIR="${DOTFILES}" "${bin}" "$@"
      ;;
  esac
}

if run_agent_sync "$@"; then
  exit 0
fi

echo "sync-ai-assistants: agent-sync not available; using legacy symlink sync" >&2
LEGACY="$(cd "$(dirname "$0")" && pwd)/sync-ai-assistants.legacy"
if [[ -x "${LEGACY}" ]]; then
  exec env DOTFILES_DIR="${DOTFILES}" "${LEGACY}" "$@"
fi

echo "sync-ai-assistants: missing agent-sync and sync-ai-assistants.legacy" >&2
exit 1
