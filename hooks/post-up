#!/bin/sh

# Prefer agent-sync; fall back to legacy symlink sync during migration.
DOTFILES="${DOTFILES_DIR:-$HOME/dotfiles}"
if [ ! -d "$DOTFILES" ] && [ -d "$HOME/dotfiles-local" ]; then
  DOTFILES="$HOME/dotfiles-local"
fi

if [ -x "$HOME/.local/bin/agent-sync" ]; then
  DOTFILES_DIR="$DOTFILES" "$HOME/.local/bin/agent-sync" sync \
    || echo "agent-sync sync failed (see above)" >&2
elif [ -x "$DOTFILES/bin/agent-sync" ]; then
  DOTFILES_DIR="$DOTFILES" "$DOTFILES/bin/agent-sync" sync \
    || echo "agent-sync sync failed (see above)" >&2
elif [ -x "$HOME/dotfiles-local/bin/sync-ai-assistants" ]; then
  DOTFILES_DIR="$HOME/dotfiles-local" "$HOME/dotfiles-local/bin/sync-ai-assistants" \
    || echo "sync-ai-assistants failed (see above)" >&2
elif [ -x "$HOME/dotfiles/bin/sync-ai-assistants" ]; then
  DOTFILES_DIR="$HOME/dotfiles" "$HOME/dotfiles/bin/sync-ai-assistants" \
    || echo "sync-ai-assistants failed (see above)" >&2
fi

touch "$HOME"/.psqlrc.local

if [ -e "$HOME"/.vim/autoload/plug.vim ]; then
  vim -E -s +PlugUpgrade +qa
else
  curl -fLo "$HOME"/.vim/autoload/plug.vim --create-dirs \
      https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
fi

vim -u "$HOME"/.vimrc.bundles +PlugUpdate +PlugClean! +qa

reset -Q

if [ -f "$HOME/.git_template/HEAD" ] && \
  [ "$(cat "$HOME/.git_template/HEAD")" = "ref: refs/heads/main" ]; then
  echo "Removing ~/.git_template/HEAD in favor of defaultBranch" >&2
  rm -f ~/.git_template/HEAD
fi

# detect old OS X broken /etc/zshenv and suggest rename
if grep -qw path_helper /etc/zshenv 2>/dev/null; then
  dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

  cat <<MSG >&2
Warning: \`/etc/zshenv' configuration file on your system may cause unexpected
PATH changes on subsequent invocations of the zsh shell. The solution is to
rename the file to \`zprofile':
  sudo mv /etc/{zshenv,zprofile}

(called from ${dir}/post-up:${LINENO})

MSG
fi
